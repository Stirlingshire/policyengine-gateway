{
	admin off
	auto_https off
}

:8080 {
	# Unauthenticated so the image's built-in HEALTHCHECK and Aptible health checks pass.
	handle /liveness_check {
		reverse_proxy 127.0.0.1:8081
	}

	@authed header Authorization "Bearer {$API_KEY}"
	handle @authed {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		respond 401
	}
}
